{
  "name": "root",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/janghye0k/doumi"
  },
  "scripts": {
    "build": "turbo run build --filter=doumi",
    "test": "turbo run test --filter=doumi",
    "lint": "turbo run lint --filter=doumi",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.5.0",
    "@commitlint/config-conventional": "^18.5.0",
    "lint-staged": "^15.2.0",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "simple-git-hooks": "^2.13.1",
    "turbo": "^2.10.5",
    "typescript": "~6.0.3"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "commit-msg": "npx commitlint --edit $1"
  },
  "lint-staged": {
    "*.{js,ts,mjs,cjs}": [
      "oxlint --fix",
      "oxfmt --write"
    ],
    "*.{json,md,yml,yaml}": [
      "oxfmt --write"
    ]
  },
  "packageManager": "pnpm@10.32.1"
}
