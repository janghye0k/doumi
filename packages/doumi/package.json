{
  "name": "doumi",
  "version": "1.1.7",
  "description": "Javascript Utilities",
  "keywords": [
    "util",
    "utilities"
  ],
  "homepage": "https://janghye0k.github.io/doumi",
  "bugs": {
    "url": "https://github.com/janghye0k/doumi/issues"
  },
  "license": "MIT",
  "author": "JangHyeok Kim",
  "repository": {
    "type": "git",
    "url": "https://github.com/janghye0k/doumi"
  },
  "files": [
    "dist",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "prebuild": "pnpm clean",
    "build": "rollup -c && node -e \"require('node:fs').copyFileSync('dist/index.d.ts','dist/index.d.cts')\"",
    "lint": "oxlint src/ tests/",
    "lint:fix": "oxlint --fix src/ tests/",
    "test:only": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test": "vitest run --coverage",
    "release": "commit-and-tag-version",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@oxc-project/runtime": "^0.140.0",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@testing-library/jest-dom": "^6.2.0",
    "@types/node": "^20.10.8",
    "@vitest/coverage-v8": "^4.1.10",
    "commit-and-tag-version": "^12.7.3",
    "jsdom": "^29.1.1",
    "rimraf": "^6.1.3",
    "rollup": "^4.9.4",
    "rollup-plugin-dts": "^6.1.0",
    "tslib": "^2.6.2",
    "typescript": "~6.0.3",
    "unplugin-oxc": "^0.6.1",
    "vitest": "^4.1.10"
  }
}
